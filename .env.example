# Copy to .env for the operational shell scripts. The .env file is ignored.
TDENGINE_HOST=localhost
TDENGINE_PORT=6030
TDENGINE_USER=root
TDENGINE_PASSWORD=
TDENGINE_DATABASE=cb_dev

# Optional interpreter override. Defaults to python3 from PATH.
# PYTHON_BIN=/path/to/python

# Optional remote Wind gateway.
# WIND_GATEWAY_URL=http://127.0.0.1:18765
# WIND_GATEWAY_TOKEN=
