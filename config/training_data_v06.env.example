# The default path is config/jqdata_credentials.toml. It is ignored by Git and
# should be chmod 600. Environment variables below override that file.

export JQDATA_USERNAME="your_jqdata_phone_or_username"
export JQDATA_PASSWORD="your_jqdata_password"

# Optional alternate TOML file with a [jqdata] username/password table.
# export JQDATA_CREDENTIALS_FILE="$HOME/.config/cb-system/jqdata_credentials.toml"

# Alternative: store each secret in a chmod 600 file and point the provider at it.
# export JQDATA_USERNAME_FILE="$HOME/.config/cb-system/jqdata_username"
# export JQDATA_PASSWORD_FILE="$HOME/.config/cb-system/jqdata_password"

# Force one provider: windpy or http. Default auto uses WindPy when importable.
# export WIND_PROVIDER="windpy"

# Mac-side Wind bridge fallback. Leave unset when local WindPy is available.
# export WIND_PROVIDER_URL="http://127.0.0.1:18080"
# export WIND_PROVIDER_TOKEN="optional_bridge_token"
